NODE_ENV=development
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./radar.sqlite
PORT=3001

# Configure these on the backend host when using Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:5173
# Only for one-time imports from SQLite; do not set it for normal app operation.
SUPABASE_MIGRATION_USER_ID=

# Used only for the local SQLite single-user login.
JWT_SECRET=
